TELEGRAM_BOT_TOKEN=
LASTFM_API_KEY=
TELEGRAM_API_BASE_URL=https://api.telegram.org
LIL_BRO_BOT_USERNAME=musicbehbot

# Optional Telegram Mini App. Public HTTPS origin forwarded to this local server.
MINIAPP_URL=
MINIAPP_HOST=127.0.0.1
MINIAPP_PORT=8080

# See GET_SONG.md; enable only for authorized sources/use.
GET_SONG_ENABLED=false
# youtube = direct yt-dlp fetch; lilbro = bot-to-bot video/audio source.
# Enable bot-to-bot communication for both bots in BotFather before using lilbro.
GET_SONG_PROVIDER=youtube
# Bot transport requires the upstream bot to handle bot senders (not yet verified).
# User transport requires explicit local sign-in; never copy a browser session.
GET_SONG_LILBRO_TRANSPORT=bot
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
GET_SONG_LILBRO_SESSION=data/lilbro-user.session
GET_SONG_PER_HOUR=5
GET_SONG_QUEUE_LIMIT=20
GET_SONG_PER_USER_QUEUE=2
GET_SONG_MAX_DURATION=900
GET_SONG_MAX_BYTES=45000000
GET_SONG_TIMEOUT=180
GET_SONG_DISK_BYTES=150000000
GET_SONG_RETENTION_DAYS=7

# Lyrics phrase discovery: youtube (free metadata search), musixmatch, or off.
# YouTube mode needs requirements-audio.txt but downloads no media during search.
LYRICS_SEARCH_PROVIDER=youtube
# Optional, only required when LYRICS_SEARCH_PROVIDER=musixmatch. Never put in a client.
MUSIXMATCH_API_KEY=

# Anonymous catalogue metadata for popular songs and partial-title coverage.
SEARCH_DEEZER_ENABLED=true
# Audio recognition via ShazamIO; no API key. Set false for metadata-only audio.
RECOGNITION_ENABLED=true
